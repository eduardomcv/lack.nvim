{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": ["lua/?.lua", "lua/?/init.lua", "?.lua", "?/init.lua"],
    "pathStrict": true
  },
  "workspace": {
    "checkThirdParty": false,
    "library": ["${env:VIMRUNTIME}/lua"]
  },
  "diagnostics": {
    "globals": ["vim"]
  }
}
